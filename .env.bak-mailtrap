APP_NAME=2pets
APP_ENV=local
APP_KEY=base64:Q/kFU8PfU9QSzZdYDDkfaayf4YR++Yn5scTTrnnVLvA=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:9200

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS (Docker)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=twopets
DB_USERNAME=twopets
DB_PASSWORD=twopets_secret

# ---------------------------------------------------------------------------
# Redis (Docker)
# ---------------------------------------------------------------------------
# API is stateless (Sanctum tokens) — no session needed.
# Use 'cookie' for minimal overhead; sessions are not used by API routes.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@2pets.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AWS S3 / MinIO (Docker)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=twopets
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Google Maps Platform
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# OAuth (Google)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Mercado Pago
# ---------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Vite
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Feature flags — V2/V3 off until MVP ships
FEATURE_TUTOR_EXPENSES=false
FEATURE_ADVANTAGE_CLUB=false
FEATURE_LOYALTY=false
FEATURE_CLINIC_ERP=true
FEATURE_PETSHOP_ERP=false
FEATURE_VIDEO_CONSULTATIONS=false
FEATURE_AI_GUARDIAN=false
FEATURE_AI_BUSINESS=true   # ligado localmente para tornar o endpoint mensuravel (alvo da Fase 8)
FEATURE_MARKETPLACE=false
FEATURE_INSURANCE=false
FEATURE_ADVERTISING=false
FEATURE_SOCIAL_MEDIA=false
