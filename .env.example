APP_NAME=2pets
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS (Docker)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=twopets
DB_USERNAME=twopets
DB_PASSWORD=twopets_secret

# ---------------------------------------------------------------------------
# Redis (Docker)
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@2pets.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AWS S3 / MinIO (Docker)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=twopets
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Google Maps Platform
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# OAuth (Google)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ---------------------------------------------------------------------------
# Mercado Pago
# ---------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# Legacy HTTP API was shut down by Google on 2024-06-20 — use HTTP v1.
# How to obtain credentials:
#   1. https://console.firebase.google.com/ → select project
#   2. Project Settings (gear icon) → "General" tab → copy the "Project ID"
#      into FCM_PROJECT_ID below.
#   3. Project Settings → "Service accounts" tab → "Generate new private key"
#      → save the downloaded JSON as storage/app/firebase-service-account.json.
#      The path under storage/app/ is already gitignored.
# Use FCM_SERVICE_ACCOUNT_JSON_BASE64 (base64-encoded JSON content) instead of
# the path on managed hosts (Heroku/Render/etc.) where you can't ship files.
# ---------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=storage/app/firebase-service-account.json
# FCM_SERVICE_ACCOUNT_JSON_BASE64=
# FCM_SERVER_KEY=  # @deprecated — Legacy FCM HTTP API was shut down on 2024-06-20

# ---------------------------------------------------------------------------
# Vite
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Feature flags — V2/V3 features stay off until MVP ships
# Override in staging to validate WIP. Keep off in production.
# ---------------------------------------------------------------------------
FEATURE_TUTOR_EXPENSES=false
FEATURE_ADVANTAGE_CLUB=false
FEATURE_LOYALTY=false
FEATURE_CLINIC_ERP=true
FEATURE_PETSHOP_ERP=false
FEATURE_VIDEO_CONSULTATIONS=false
FEATURE_AI_GUARDIAN=false
FEATURE_AI_BUSINESS=false
FEATURE_MARKETPLACE=false
FEATURE_INSURANCE=false
FEATURE_ADVERTISING=false
FEATURE_SOCIAL_MEDIA=false
